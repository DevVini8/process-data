# ==============================================================================
# Template de Variáveis de Ambiente (.env.example) - Gestão de Segurança (Fase 2)
# Copie este arquivo para .env e preencha com suas credenciais reais da Aiven.
# NUNCA faça commit do arquivo .env no repositório Git!
# ==============================================================================

# 1. Credenciais Aiven IaC (Terraform)
TF_VAR_aiven_api_token="avn_token_exemplo_substituir"
TF_VAR_aiven_project_name="meu-projeto-bigdata-aiven"

# 2. Conexão com o Banco de Dados PostgreSQL (Aiven Free Tier - Limite 1 GB)
DB_HOST="pg-bigdata-ods5-ods18-seu-projeto.a.aivencloud.com"
DB_PORT="25060"
DB_NAME="dw_violencia_interseccional"
DB_USER="avnadmin"
DB_PASSWORD="sua_senha_segura_aiven"
DB_SSLMODE="require"

# URI completa opcional (sobrepõe os campos individuais caso definida)
DATABASE_URL="postgresql://avnadmin:sua_senha_segura_aiven@pg-bigdata-ods5-ods18-seu-projeto.a.aivencloud.com:25060/dw_violencia_interseccional?sslmode=require"

# 3. Parâmetros do Pipeline ETL e Amostragem (Limite 1 GB Aiven)
ETL_CHUNK_SIZE="5000"
ETL_MAX_DB_SIZE_MB="850"
ETL_KEEP_ZERO_VICTIM_ROWS="false"
ETL_ZERO_ROWS_SAMPLE_FRAC="0.02"
